# ==========================================
# ProjectVault Global Git Ignore Configuration
# ==========================================

# Environment & Secrets (NEVER COMMIT SECRETS)
.env
.env.*
!.env.example
*.env
*.env.local
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Node.js & Frontend build artifacts
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Java & Spring Boot Maven build output
**/target/
target/
*.class
*.jar
*.war
*.ear
.gradle/
bin/

# Python virtual environments & bytecode cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
venv/
.venv/
env/
ENV/
*.egg-info/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*.iml
*.iws
*.ipr
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# Antigravity & Agent workspace temp directories
.system_generated/
.gemini/
brain/
knowledge/
tmp/
*.tmp

# Application Storage & Uploaded Files
storage/projects/*
!storage/projects/.gitkeep
storage/local-dir/
storage/local-dir/*

# Logs & OS generated files
*.log
.DS_Store
Thumbs.db
desktop.ini
