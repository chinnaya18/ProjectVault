# ==========================================
# ProjectVault Deployment Environment Variables
# Copy to .env and configure real credentials
# NEVER commit .env to GitHub!
# ==========================================

# Database Configuration (PostgreSQL + pgvector)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=projectvault
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here

# JWT Authentication
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Google Gemini AI Service
GEMINI_API_KEY=${GEMINI_API_KEY}
GEMINI_MODEL=gemini-3.6-flash

# Mail / SMTP Configuration (Gmail or Department SMTP Relay)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=psgtech.projectvault@gmail.com
SPRING_MAIL_PASSWORD=your_new_google_app_password_here

# File Storage Configuration
STORAGE_LOCAL_DIR=/app/storage
